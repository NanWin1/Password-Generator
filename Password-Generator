import random
import string

def get_user_preference():
    use_lower = input("Do you want small letters(ABC)?Answer me in y or n!")
    use_upper = input("Do you want capital letters(abc)?Answer me in y or n!")
    use_digits = input("Do you want digits(123)?Answer me in y or n!")
    use_symbols = input("Do you want symbols(@#!)?Answer me in y or n!")
    
    if not(use_lower or use_upper or use_digits or use_symbols):
        print("I will put everything!")
        use_lower = use_upper = use_digits = use_symbols = True
    return use_lower,use_upper,use_digits,use_symbols
    
def build_char_set(use_lower,use_upper,use_digits,use_symbols):
    chars = ''
    if use_lower:
        chars += string.ascii_lowercase
    if use_upper:
        chars += string.ascii_uppercase
    if use_digits:
        chars += string.digits
    if use_symbols:
        chars += string.punctuation
    return chars
    
def generate_password(length, char_set):
    return ''.join(random.choice(char_set)for _ in range(length))
    
print("-----Custom Password Generator-----")    

use_lower, use_upper, use_digits, use_symbols = get_user_preference()    
chars = build_char_set(use_lower,use_upper,use_digits,use_symbols)

try:
    length = int(input("How many letters do you want to add?"))
except ValueError:
    print("I set the length to 10!")
    length = 10
    
try:
    num_password = int(input("How many passwords do you want to generate?"))
except ValueError:
    print("I will generate 1 password for you!")
    num_password = 1
    

    
print("You Passwords!")    
for i in range(1, num_password + 1):
    password = generate_password(length, chars)
    print(f"{i}. {password}")
    
print("\nThanks for using my app!")    
    

    
    